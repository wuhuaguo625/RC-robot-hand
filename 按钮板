#include <Arduino.h>
#include <string.h>
#include <stdio.h>
#include <Wire.h>
#include <U8x8lib.h>

// 独立遥控板：SSD1306 128x64 OLED，SDA=A4/PC4，SCL=A5/PC5。
// OLED电源和GND按模块丝印接，不能凭4针外观猜测顺序。
// D13/PB5（原理图LED4）用作工作状态灯。
// 7.4V/5V电源灯需由LED和限流电阻接对应电源，不能用本程序替代。
// 本板没有已确认的电压采样电路，因此不显示虚构的电压数值。
// KEY1=PB0/D8 KEY2=PB1/D9 KEY3=PB2/D10 KEY4=PB3/D11
// 外部10k上拉，按下接地。D0/D1硬件UART，9600 8N1。
const byte KEY_PINS[4] = {8, 9, 10, 11};
const unsigned long DEBOUNCE_MS = 40;
const unsigned long REPLY_TIMEOUT_MS = 2000;
bool rawLevel[4] = {HIGH, HIGH, HIGH, HIGH};
bool stableLevel[4] = {HIGH, HIGH, HIGH, HIGH};
unsigned long changedAt[4] = {0, 0, 0, 0};

enum RemoteState : byte {UNKNOWN_STATE, IDLE_STATE, RECORDING_STATE, BUSY_STATE};
RemoteState armState = UNKNOWN_STATE;
byte taskIndex = 0; // 仅收到对应ACK后递增：A->B->C->A
char pending = 0;  // A/B/C, R=REC, S=STOP, P=PLAY, H=HOME
unsigned long sentAt = 0, lastQuery = 0;


// OLED使用U8x8文字模式，避免1KB图形帧缓存。
U8X8_SSD1306_128X64_NONAME_HW_I2C oled(U8X8_PIN_NONE);
const byte STATUS_LED_PIN = 13;
const unsigned long LINK_TIMEOUT_MS = 5000;
bool oledPresent = false, haveReply = false, haveAngles = false;
unsigned long lastHeardAt = 0, lastDisplayAt = 0, recordingStartedAt = 0;
unsigned int angles[4] = {90, 90, 90, 90};
unsigned int recordFrames = 0;
unsigned long recordDurationMs = 0;
char displayMode[14] = "CONNECTING";
char lastEvent[17] = "WAIT LINK";
char activeTask = '-';
char previousRows[8][17] = {{0}};
byte displayRow = 0;

bool linkOnline() {
    return haveReply && millis() - lastHeardAt < LINK_TIMEOUT_MS;
}

void eventFlash(const __FlashStringHelper *message) {
    strncpy_P(lastEvent, (const char *)message, sizeof(lastEvent) - 1);
    lastEvent[sizeof(lastEvent) - 1] = '\0';
}

void observeLine(const char *line) {
    // 仅观察机械臂回执供显示使用，不向串口发送调试文字。
    if (!strncmp(line, "STATE:", 6) || !strncmp(line, "ACK:", 4) ||
        !strncmp(line, "DONE:", 5) || !strncmp(line, "ERR:", 4) || !strcmp(line, "BUSY")) {
        haveReply = true; lastHeardAt = millis();
    }
    if (!strncmp(line, "STATE:", 6)) {
        strncpy(displayMode, line + 6, sizeof(displayMode) - 1);
        displayMode[sizeof(displayMode) - 1] = '\0';
        if (!strcmp(line + 6, "IDLE")) activeTask = '-';
        if (!strcmp(line + 6, "RECORDING") && armState != RECORDING_STATE)
            recordingStartedAt = millis();
    } else if (!strncmp(line, "ANGLES:", 7)) {
        unsigned int b, r, f, c;
        if (sscanf(line + 7, "%u,%u,%u,%u", &b, &r, &f, &c) == 4 &&
            b <= 180 && r <= 180 && f <= 180 && c <= 180) {
            angles[0] = b; angles[1] = r; angles[2] = f; angles[3] = c;
            haveAngles = true;
        }
    } else if (!strncmp(line, "RECORD:", 7) || !strncmp(line, "SAVED:", 6)) {
        bool saved = !strncmp(line, "SAVED:", 6);
        unsigned int frames; unsigned long duration;
        if (sscanf(line + (saved ? 6 : 7), "%u,%lu", &frames, &duration) == 2) {
            recordFrames = frames; recordDurationMs = duration;
            if (saved) eventFlash(F("SAVED OK"));
        }
    } else if (!strncmp(line, "ACK:", 4) || !strncmp(line, "DONE:", 5) ||
               !strncmp(line, "ERR:", 4) || !strcmp(line, "BUSY") ||
               !strncmp(line, "EVT:", 4)) {
        strncpy(lastEvent, line, sizeof(lastEvent) - 1);
        lastEvent[sizeof(lastEvent) - 1] = '\0';
        if (!strncmp(line, "ACK:", 4)) {
            const char *ack = line + 4;
            if (ack[0] >= 'A' && ack[0] <= 'C' && !ack[1]) {
                activeTask = ack[0]; strcpy(displayMode, "AUTO");
            } else if (!strcmp(ack, "REC")) {
                recordingStartedAt = millis(); strcpy(displayMode, "RECORDING");
            } else if (!strcmp(ack, "STOP") || !strcmp(ack, "X")) strcpy(displayMode, "IDLE");
            else if (!strcmp(ack, "PLAY")) strcpy(displayMode, "PLAY_PREPARE");
            else if (!strcmp(ack, "HOME")) { activeTask = '-'; strcpy(displayMode, "HOME"); }
        }
        if (!strncmp(line, "DONE:", 5) || !strcmp(line, "EVT:REC_CANCELLED")) {
            strcpy(displayMode, "IDLE"); activeTask = '-';
        }
        if (!strcmp(line, "EVT:PLAY_STARTED")) strcpy(displayMode, "PLAYBACK");
        if (!strcmp(line, "EVT:RECORD_FULL")) eventFlash(F("FULL / SAVED"));
    }
    if (!strncmp(line, "MeArm Task 1/2/3 Ready", sizeof("MeArm Task 1/2/3 Ready") - 1)) {
        activeTask = '-'; haveAngles = false; recordFrames = 0; recordDurationMs = 0;
        strcpy(displayMode, "CONNECTING"); eventFlash(F("ARM RESTART"));
    }
}

void initOLED() {
    Wire.begin();
    Wire.setWireTimeout(5000, true); // IIC故障不能永久卡住按键程序
    byte address = 0;
    for (byte candidate = 0x3C; candidate <= 0x3D; ++candidate) {
        Wire.beginTransmission(candidate);
        if (Wire.endTransmission() == 0) { address = candidate; break; }
    }
    if (!address) return;
    oled.setI2CAddress(address << 1); // U8x8使用左移一位的IIC地址
    oled.setBusClock(100000);
    oled.begin();
    Wire.setWireTimeout(5000, true);
    oled.setFont(u8x8_font_chroma48medium8_r);
    oledPresent = true;
}

void updateOLED() {
    // 一轮只更新一行，减少屏幕刷新对串口接收和消抖的影响。
    if (!oledPresent || millis() - lastDisplayAt < 25) return;
    lastDisplayAt = millis();
    char line[17] = {0};
    bool online = linkOnline();
    switch (displayRow) {
        case 0:
            snprintf_P(line, sizeof(line), PSTR("MEARM LINK:%s"), online ? "OK" : "LOST"); break;
        case 1:
            snprintf_P(line, sizeof(line), PSTR("%s"), !online ? "WAIT ARM LINK" :
                       armState == UNKNOWN_STATE ? "QUERY STATE" : displayMode); break;
        case 2:
            snprintf_P(line, sizeof(line), PSTR("TASK:%c NEXT:%c"),
                       online ? activeTask : '-', 'A' + taskIndex); break;
        case 3: case 4:
            if (!online || !haveAngles) {
                strncpy_P(line, displayRow == 3 ? PSTR("B:--- R:---") : PSTR("F:--- C:---"), sizeof(line));
            } else {
                byte i = displayRow == 3 ? 0 : 2;
                snprintf_P(line, sizeof(line), displayRow == 3 ? PSTR("B:%3u R:%3u") : PSTR("F:%3u C:%3u"),
                           angles[i], angles[i + 1]);
            }
            break;
        case 5: {
            unsigned long ms = online && armState == RECORDING_STATE
                ? millis() - recordingStartedAt : recordDurationMs;
            if (online && armState == RECORDING_STATE)
                snprintf_P(line, sizeof(line), PSTR("REC:%2lu.%lus"),
                           min(ms / 1000, 99UL), (ms / 100) % 10);
            else
                snprintf_P(line, sizeof(line), PSTR("SAVE:%2lu.%lus F%u"),
                           min(ms / 1000, 99UL), (ms / 100) % 10, recordFrames);
            break;
        }
        case 6: strncpy(line, lastEvent, sizeof(line)); break;
        case 7:
            if (pending) {
                const char *cmd = pending == 'R' ? "REC" : pending == 'S' ? "STOP" :
                    pending == 'P' ? "PLAY" : pending == 'H' ? "HOME" : NULL;
                if (cmd) snprintf_P(line, sizeof(line), PSTR("SEND:%s"), cmd);
                else snprintf_P(line, sizeof(line), PSTR("SEND:%c"), pending);
            } else if (!online) strncpy_P(line, PSTR("CHECK TX/RX"), sizeof(line));
            else if (armState == UNKNOWN_STATE) strncpy_P(line, PSTR("QUERYING STATE"), sizeof(line));
            else strncpy_P(line, PSTR("READY FOR KEY"), sizeof(line));
            break;
    }
    byte length = strlen(line);
    while (length < 16) line[length++] = ' ';
    line[16] = '\0';
    if (strcmp(line, previousRows[displayRow])) {
        oled.drawString(0, displayRow, line);
        strcpy(previousRows[displayRow], line);
    }
    displayRow = (displayRow + 1) % 8;
}

void updateStatusLED() {
    bool lit;
    if (!linkOnline()) lit = (millis() / 250) % 2; // 无连接：闪烁
    else if (armState == RECORDING_STATE) lit = (millis() / 100) % 2; // 录制：快闪
    else if (armState == BUSY_STATE || pending) lit = (millis() / 500) % 2;
    else lit = true; // 在线空闲：常亮
    digitalWrite(STATUS_LED_PIN, lit ? HIGH : LOW);
}

void sendCommand(char kind) {
    switch (kind) {
        case 'A': case 'B': case 'C': Serial.println(kind); break;
        case 'R': Serial.println(F("REC")); break;
        case 'S': Serial.println(F("STOP")); break;
        case 'P': Serial.println(F("PLAY")); break;
        case 'H': Serial.println(F("HOME")); break;
    }
    pending = kind;
    sentAt = millis();
}

void receiveLine(const char *line) {
    observeLine(line);
    if (!strncmp(line, "STATE:", 6)) {
        const char *state = line + 6;
        if (!strcmp(state, "IDLE")) armState = IDLE_STATE;
        else if (!strcmp(state, "RECORDING")) armState = RECORDING_STATE;
        else armState = BUSY_STATE;
        return;
    }
    if (!strncmp(line, "ACK:", 4)) {
        const char *ack = line + 4;
        if (ack[0] >= 'A' && ack[0] <= 'C' && ack[1] == '\0') {
            if (pending == ack[0]) taskIndex = (taskIndex + 1) % 3;
            pending = 0;
            armState = BUSY_STATE;
        } else if (!strcmp(ack, "REC")) {
            pending = 0; armState = RECORDING_STATE;
        } else if (!strcmp(ack, "STOP") || !strcmp(ack, "X")) {
            pending = 0; armState = IDLE_STATE;
        } else if (!strcmp(ack, "PLAY") || !strcmp(ack, "HOME")) {
            pending = 0; armState = BUSY_STATE;
        }
        return;
    }
    if (!strncmp(line, "DONE:", 5) || !strcmp(line, "EVT:REC_CANCELLED") ||
        !strcmp(line, "Movement Stopped")) {
        armState = IDLE_STATE;
    }
    if (!strcmp(line, "BUSY") || !strncmp(line, "ERR:", 4)) {
        pending = 0;
        armState = UNKNOWN_STATE; // 下一次查询取得机械臂真实状态
        // 机械臂拒绝命令时不推进A/B/C循环，下一次查询同步状态。
    }
    if (!strncmp(line, "MeArm Task 1/2/3 Ready", sizeof("MeArm Task 1/2/3 Ready") - 1)) {
        pending = 0; armState = UNKNOWN_STATE; taskIndex = 0;
    }
}

void receiveSerial() {
    static char buffer[64];
    static byte length = 0;
    static bool overflow = false;
    byte budget = 32;
    while (budget-- && Serial.available()) {
        char ch = (char)Serial.read();
        if (ch == '\r') continue;
        if (ch == '\n') {
            buffer[length] = '\0';
            if (!overflow && length) receiveLine(buffer);
            length = 0; overflow = false;
        } else if (!overflow) {
            if (length < sizeof(buffer) - 1) buffer[length++] = ch;
            else overflow = true;
        }
    }
}

void onKeyPressed(byte key) {
    // HOME优先于BUSY和等待回执，其他按键必须等待上一条回执。
    if (key == 3) { sendCommand('H'); return; }
    if (pending || armState == UNKNOWN_STATE || !linkOnline()) return;
    if (key == 0 && armState == IDLE_STATE) sendCommand('A' + taskIndex);
    else if (key == 1) {
        if (armState == IDLE_STATE) sendCommand('R');
        else if (armState == RECORDING_STATE) sendCommand('S');
    } else if (key == 2 && armState == IDLE_STATE) sendCommand('P');
}

void scanKeys() {
    unsigned long now = millis();
    byte events = 0, held = 0;
    for (byte i = 0; i < 4; ++i) {
        bool level = digitalRead(KEY_PINS[i]);
        if (level != rawLevel[i]) { rawLevel[i] = level; changedAt[i] = now; }
        if (level == LOW) held |= (1 << i);
        if (now - changedAt[i] >= DEBOUNCE_MS && stableLevel[i] != level) {
            stableLevel[i] = level;
            if (level == LOW) events |= (1 << i);
        }
    }
    if (events & 8) { onKeyPressed(3); return; }
    // 多个普通按键同时按下则不发命令，避免歧义。HOME仍优先。
    if (held && (held & (held - 1))) return;
    for (byte i = 0; i < 3; ++i) if (events & (1 << i)) onKeyPressed(i);
}

void setup() {
    Serial.begin(9600);
    pinMode(STATUS_LED_PIN, OUTPUT);
    digitalWrite(STATUS_LED_PIN, LOW);
    for (byte i = 0; i < 4; ++i) {
        pinMode(KEY_PINS[i], INPUT_PULLUP);
        rawLevel[i] = stableLevel[i] = digitalRead(KEY_PINS[i]);
    }
    initOLED();
    Serial.println(F("?")); // 查询状态，不把调试文字发给机械臂
}

void loop() {
    receiveSerial();
    scanKeys();
    if (pending && millis() - sentAt >= REPLY_TIMEOUT_MS) {
        // 不盲目重发抓取命令，以免重复动作。查询后允许用户再次按键。
        pending = 0; armState = UNKNOWN_STATE;
        eventFlash(F("ACK TIMEOUT"));
    }
    if (haveReply && !linkOnline() && armState != UNKNOWN_STATE) {
        armState = UNKNOWN_STATE; eventFlash(F("LINK LOST"));
    }
    if (!pending && millis() - lastQuery >= 1000) {
        Serial.println(F("?")); lastQuery = millis();
    }
    updateOLED();
    updateStatusLED();
}
