#include <Servo.h>

Servo baseServo;
Servo rArmServo;
Servo fArmServo;
Servo clawServo;

// 舵机引脚
const int BASE_PIN = 9;
const int RARM_PIN = 8;
const int FARM_PIN = 7;
const int CLAW_PIN = 6;

// 当前角度
int baseAngle = 90;
int rArmAngle = 90;
int fArmAngle = 90;
int clawAngle = 90;

// ============================================================
// 初始化
// ============================================================

void setup() {
    Serial.begin(9600);

    baseServo.attach(BASE_PIN);
    rArmServo.attach(RARM_PIN);
    fArmServo.attach(FARM_PIN);
    clawServo.attach(CLAW_PIN);

    baseServo.write(baseAngle);
    rArmServo.write(rArmAngle);
    fArmServo.write(fArmAngle);
    clawServo.write(clawAngle);

    Serial.println();
    Serial.println("================================");
    Serial.println(" MeArm 极限角度测试");
    Serial.println("================================");
    Serial.println("指令格式：");
    Serial.println("  b45  -> Base");
    Serial.println("  r90  -> RArm");
    Serial.println("  f120 -> FArm");
    Serial.println("  c60  -> Claw");
    Serial.println();
    Serial.println("角度范围：0 ~ 180");
    Serial.println("注意：接近机械极限时立即停止测试！");
    Serial.println("================================");
}

// ============================================================
// 主循环
// ============================================================

void loop() {
    if (Serial.available() > 0) {
        String command = Serial.readStringUntil('\n');
        command.trim();

        if (command.length() < 2) {
            return;
        }

        controlServo(command);
    }
}

// ============================================================
// 解析串口指令
// ============================================================

void controlServo(String command) {
    // 第一个字符表示哪个舵机
    char servoName = command.charAt(0);

    // 后面的内容转换成角度
    int angle = command.substring(1).toInt();

    // 检查角度范围
    if (angle < 0 || angle > 180) {
        Serial.println("错误：角度必须在 0 ~ 180 之间");
        return;
    }

    // 不区分大小写
    servoName = tolower(servoName);

    switch (servoName) {

        case 'b':
            baseAngle = angle;
            baseServo.write(baseAngle);

            Serial.print("Base = ");
            Serial.println(baseAngle);
            break;

        case 'r':
            rArmAngle = angle;
            rArmServo.write(rArmAngle);

            Serial.print("R Arm = ");
            Serial.println(rArmAngle);
            break;

        case 'f':
            fArmAngle = angle;
            fArmServo.write(fArmAngle);

            Serial.print("F Arm = ");
            Serial.println(fArmAngle);
            break;

        case 'c':
            clawAngle = angle;
            clawServo.write(clawAngle);

            Serial.print("Claw = ");
            Serial.println(clawAngle);
            break;

        default:
            Serial.println("错误：未知舵机");
            Serial.println("请使用 b / r / f / c");
            break;
    }
}

