// ============================================================
//                24. 摇杆主方向判断
// ============================================================

// 同一个摇杆的两个轴
// 哪个偏离中心更多，就响应哪个
//
// 0：不动作
// 1：X方向
// 2：Y方向

int getMainDirection(
    int xValue,
    int yValue,
    int xCenter,
    int yCenter
) {

    int dx = abs(xValue - xCenter);

    int dy = abs(yValue - yCenter);

    bool xActive = dx > DEAD_ZONE;

    bool yActive = dy > DEAD_ZONE;

    if (!xActive && !yActive) {
        return 0;
    }

    if (xActive && !yActive) {
        return 1;
    }

    if (!xActive && yActive) {
        return 2;
    }

    // 两个方向都超过死区
    // 只响应偏移较大的方向

    if (dx > dy) {
        return 1;
    }

    if (dy > dx) {
        return 2;
    }

    return 0;
}

// ============================================================
//                25. 摇杆控制单个舵机
// ============================================================

void controlJoystickServo(
    int joystickValue,
    int &servoAngle,
    Servo &servo,
    int minAngle,
    int maxAngle,
    unsigned long &lastMove,
    bool reverseDirection,
    int joystickCenter
) {

    unsigned long now = millis();

    // 控制运动速度

    if (
        now - lastMove <
        (unsigned long)moveInterval
    ) {
        return;
    }

    int difference = joystickValue - joystickCenter;

    // 死区内不动作

    if (abs(difference) <= DEAD_ZONE) {
        return;
    }

    // 正方向

    if (difference > 0) {

        if (reverseDirection) {
            servoAngle--;
        }
        else {
            servoAngle++;
        }
    }

    // 反方向

    else {

        if (reverseDirection) {
            servoAngle++;
        }
        else {
            servoAngle--;
        }
    }

    // 角度限位

    servoAngle = constrain(
        servoAngle,
        minAngle,
        maxAngle
    );

    // 输出舵机

    servo.write(servoAngle);

    lastMove = now;
}

// ============================================================
//                26. 摇杆控制主函数
// ============================================================

void joystickControl() {
    // 回放和回中独占舵机；录制允许原来的摇杆逻辑运行。
    if (mode == MODE_PLAY_PREPARE || mode == MODE_PLAYBACK || mode == MODE_HOME) return;

    // 读取四个摇杆

    int baseJoy = analogRead(JOY_BASE);

    int rArmJoy = analogRead(JOY_RARM);

    int fArmJoy = analogRead(JOY_FARM);

    int clawJoy = analogRead(JOY_CLAW);

    // 左摇杆主方向

    int leftDirection = getMainDirection(
        baseJoy,
        rArmJoy,
        JOY_BASE_CENTER,
        JOY_RARM_CENTER
    );

    // 右摇杆主方向

    int rightDirection = getMainDirection(
        fArmJoy,
        clawJoy,
        JOY_FARM_CENTER,
        JOY_CLAW_CENTER
    );

    bool joystickMoving =
        (leftDirection != 0) ||
        (rightDirection != 0);

    // ====================================================
    // 人工摇杆优先
    // ====================================================

    if (joystickMoving) {
        if (mode != MODE_RECORDING && mode != MODE_IDLE) stopAllMovement();

        // 如果A/B任务正在执行，取消任务

        cancelTask();

        replaying = false;

        autoMoving = false;

        // 目标角度同步
        // 防止摇杆松开以后舵机回弹

        baseTarget = baseAngle;
        rArmTarget = rArmAngle;
        fArmTarget = fArmAngle;
        clawTarget = clawAngle;
    }

    // ====================================================
    // 左摇杆：底座与大臂
    // ====================================================

    // A0：底座，反向

    if (leftDirection == 1) {

        controlJoystickServo(
            baseJoy,
            baseAngle,
            base,
            BASE_MIN,
            BASE_MAX,
            lastBaseMove,
            true,
            JOY_BASE_CENTER
        );
    }

    // A1：大臂，反向

    else if (leftDirection == 2) {

        controlJoystickServo(
            rArmJoy,
            rArmAngle,
            rArm,
            RARM_MIN,
            RARM_MAX,
            lastRArmMove,
            true,
            JOY_RARM_CENTER
        );
    }

    // ====================================================
    // 右摇杆：小臂与夹爪
    // ====================================================

    // A2：小臂，正向

    if (rightDirection == 1) {

        controlJoystickServo(
            fArmJoy,
            fArmAngle,
            fArm,
            FARM_MIN,
            FARM_MAX,
            lastFArmMove,
            false,
            JOY_FARM_CENTER
        );
    }

    // A3：夹爪，正向

    else if (rightDirection == 2) {

        controlJoystickServo(
            clawJoy,
            clawAngle,
            claw,
            CLAW_MIN,
            CLAW_MAX,
            lastClawMove,
            false,
            JOY_CLAW_CENTER
        );
    }
    if (joystickMoving) syncTargets();
}

// ============================================================
//                27. 记录当前姿态
// ============================================================

void recordCurrentPose() {

    if (poseCount >= MAX_POSES) {

        Serial.println(F("Pose Memory Full"));
        return;
    }

    recordedPoses[poseCount].base = baseAngle;

    recordedPoses[poseCount].rArm = rArmAngle;

    recordedPoses[poseCount].fArm = fArmAngle;

    recordedPoses[poseCount].claw = clawAngle;

    Serial.print(F("Record Pose "));
    Serial.println(poseCount);

    Serial.print(F("B="));
    Serial.print(baseAngle);

    Serial.print(F(" R="));
    Serial.print(rArmAngle);

    Serial.print(F(" F="));
    Serial.print(fArmAngle);

    Serial.print(F(" C="));
    Serial.println(clawAngle);

    poseCount++;
}

// ============================================================
//                28. 显示手动记录的姿态
// ============================================================

void showRecordedPoses() {

    Serial.println(F("===== Recorded Poses ====="));

    if (poseCount == 0) {

        Serial.println(F("No Recorded Poses"));
        return;
    }

    for (int i = 0; i < poseCount; i++) {

        Serial.print(F("Pose "));
        Serial.print(i);

        Serial.print(F(": B="));
        Serial.print(recordedPoses[i].base);

        Serial.print(F(" R="));
        Serial.print(recordedPoses[i].rArm);

        Serial.print(F(" F="));
        Serial.print(recordedPoses[i].fArm);

        Serial.print(F(" C="));
        Serial.println(recordedPoses[i].claw);
    }
}

// ============================================================
//                29. 开始回放手动记录的姿态
// ============================================================

void startReplay() {

    if (poseCount == 0) {

        Serial.println(F("No Poses To Replay"));
        return;
    }

    if (taskRunning()) {

        Serial.println(F("Task Busy"));
        return;
    }

    replaying = true;
    mode = MODE_POSE_REPLAY;

    replayIndex = 0;

    moveToPose(recordedPoses[0]);

    Serial.println(F("Start Replay"));
}

// ============================================================
//                30. 更新手动姿态回放
// ============================================================

void updateReplay() {

    if (!replaying) {
        return;
    }

    // 当前姿态还没有到达

    if (!poseReached(recordedPoses[replayIndex])) {
        return;
    }

    // 到达后进入下一个姿态

    replayIndex++;

    // 全部回放结束

    if (replayIndex >= poseCount) {

        replaying = false;

        mode = MODE_IDLE;
        Serial.println(F("DONE:E"));

        return;
    }

    moveToPose(recordedPoses[replayIndex]);
}

// ============================================================
//                31. 打开夹爪
// ============================================================

void openClaw() {

    clawTarget = CLAW_MIN;

    autoMoving = true;

    Serial.println(F("Open Claw"));
}

// ============================================================
//                32. 关闭夹爪
// ============================================================

void closeClaw() {

    clawTarget = CLAW_MAX;

    autoMoving = true;

    Serial.println(F("Close Claw"));
}

// ============================================================
//                33. 加快速度
// ============================================================

void increaseSpeed() {

    moveInterval -= 10;

    if (moveInterval < FASTEST) {

        moveInterval = FASTEST;
    }

    Serial.print(F("Move Interval: "));
    Serial.println(moveInterval);
}

// ============================================================
//                34. 降低速度
// ============================================================

void decreaseSpeed() {

    moveInterval += 10;

    if (moveInterval > SLOWEST) {

        moveInterval = SLOWEST;
    }

    Serial.print(F("Move Interval: "));
    Serial.println(moveInterval);
}

// ============================================================
//                35. 多舵机串口控制
// ============================================================

// 格式：x120,y80,z100
// x：底座
// y：大臂
// z：小臂

// 严格解析三个数字，格式错误时不修改任何目标。
void multiServoControl(const char *command) {
    const char *p = command;
    int values[3];
    for (byte i = 0; i < 3; ++i) {
        if (*p++ != "XYZ"[i] || !isdigit((unsigned char)*p)) {
            Serial.println(F("ERR:FORMAT")); return;
        }
        char *end;
        long angle = strtol(p, &end, 10);
        if (angle < 0 || angle > 180) { Serial.println(F("ERR:ANGLE")); return; }
        values[i] = (int)angle;
        p = end;
        if (i < 2 && *p++ != ',') { Serial.println(F("ERR:FORMAT")); return; }
    }
    if (*p) { Serial.println(F("ERR:FORMAT")); return; }
    Pose requested = {(uint8_t)values[0], (uint8_t)values[1],
                      (uint8_t)values[2], (uint8_t)clawAngle};
    moveToPose(requested);
    mode = MODE_DIRECT;
    Serial.println(F("ACK:XYZ"));
}

// ============================================================
//                36. 停止所有自动运动
// ============================================================

void stopAllMovement() {
    // X/HOME中断录制不发布新数据，也不覆盖旧数据。
    if (mode == MODE_RECORDING) Serial.println(F("EVT:REC_CANCELLED"));
    mode = MODE_IDLE;

    cancelTask();

    replaying = false;

    autoMoving = false;

    baseTarget = baseAngle;

    rArmTarget = rArmAngle;

    fArmTarget = fArmAngle;

    clawTarget = clawAngle;

    Serial.println(F("Movement Stopped"));
}

// ============================================================
//                37. 串口指令解析
// ============================================================

// 非阻塞接收一整行
// 支持9600波特率、换行结尾
// 与以后任务三按键板的通信格式兼容


// ============================================================
// 连续录制/回放：与R/P/E关键姿态记录使用不同的缓冲区
// ============================================================
void syncTargets() {
    baseTarget = baseAngle;
    rArmTarget = rArmAngle;
    fArmTarget = fArmAngle;
    clawTarget = clawAngle;
}

MotionFrame currentFrame() {
    MotionFrame frame = {(uint8_t)baseAngle, (uint8_t)rArmAngle,
                         (uint8_t)fArmAngle, (uint8_t)clawAngle};
    return frame;
}

void appendFrame() {
    if (recordingCount >= MAX_FRAMES) return;
    MotionFrame frame = currentFrame();
    motionBuffers[workBuffer][recordingCount++] = frame;
    recordingMin.base = min(recordingMin.base, frame.base);
    recordingMin.rArm = min(recordingMin.rArm, frame.rArm);
    recordingMin.fArm = min(recordingMin.fArm, frame.fArm);
    recordingMax.base = max(recordingMax.base, frame.base);
    recordingMax.rArm = max(recordingMax.rArm, frame.rArm);
    recordingMax.fArm = max(recordingMax.fArm, frame.fArm);
}

void startRecording() {
    syncTargets();
    workBuffer = 1 - savedBuffer;
    recordingCount = 0;
    recordingMin = recordingMax = currentFrame();
    recordStartedAt = millis();
    appendFrame();  // t=0第一帧
    mode = MODE_RECORDING;
    Serial.println(F("ACK:REC"));
}

void finishRecording(bool full) {
    unsigned long duration = millis() - recordStartedAt;
    if (full) duration = (MAX_FRAMES - 1UL) * RECORD_INTERVAL;
    // 手动停止时记录最后的部分周期，回放最后一帧用savedDuration定时。
    unsigned long lastSample = (recordingCount - 1UL) * RECORD_INTERVAL;
    if (!full && duration > lastSample && recordingCount < MAX_FRAMES) appendFrame();
    mode = MODE_IDLE;
    syncTargets();
    Serial.println(F("ACK:STOP"));
    if (duration <= MIN_RECORD_MS) {
        Serial.println(F("ERR:TOO_SHORT")); return;
    }
    bool moved = recordingMax.base - recordingMin.base >= MOTION_THRESHOLD ||
                 recordingMax.rArm - recordingMin.rArm >= MOTION_THRESHOLD ||
                 recordingMax.fArm - recordingMin.fArm >= MOTION_THRESHOLD;
    if (!moved) { Serial.println(F("ERR:NO_MOTION")); return; }
    savedBuffer = workBuffer;
    savedCount = recordingCount;
    savedDuration = (uint16_t)duration;
    savedValid = true;
    Serial.print(F("SAVED:")); Serial.print(savedCount);
    Serial.print(','); Serial.println(savedDuration);
    if (full) Serial.println(F("EVT:RECORD_FULL"));
}

void updateRecording() {
    if (mode != MODE_RECORDING) return;
    // 以开始时刻为基准，避免每帧累积计时误差。
    while (recordingCount < MAX_FRAMES &&
           millis() - recordStartedAt >= recordingCount * (unsigned long)RECORD_INTERVAL) {
        appendFrame();
    }
    if (recordingCount == MAX_FRAMES) finishRecording(true);
}

void startPlayback() {
    if (!savedValid) { Serial.println(F("ERR:NO_RECORD")); return; }
    MotionFrame first = motionBuffers[savedBuffer][0];
    Pose firstPose = {first.base, first.rArm, first.fArm, first.claw};
    moveToPose(firstPose);  // 先逐度回到录制起点，这段不计入回放时长
    mode = MODE_PLAY_PREPARE;
    playbackSettling = false;
    Serial.println(F("ACK:PLAY"));
}

void writeFrame(MotionFrame frame) {
    baseAngle = frame.base; rArmAngle = frame.rArm;
    fArmAngle = frame.fArm; clawAngle = frame.claw;
    base.write(baseAngle); rArm.write(rArmAngle);
    fArm.write(fArmAngle); claw.write(clawAngle);
    syncTargets();
    unsigned long now = millis();
    lastBaseMove = lastRArmMove = lastFArmMove = lastClawMove = now;
}

void updatePlayback() {
    if (mode == MODE_PLAY_PREPARE) {
        if (autoMoving) return;
        if (!playbackSettling) {
            playbackSettling = true; playbackSettleAt = millis(); return;
        }
        if (millis() - playbackSettleAt < PLAY_PREPARE_WAIT) return;
        writeFrame(motionBuffers[savedBuffer][0]);
        playbackIndex = 1;
        playbackStartedAt = millis();
        mode = MODE_PLAYBACK;
        Serial.println(F("EVT:PLAY_STARTED"));
    }
    if (mode != MODE_PLAYBACK) return;
    while (playbackIndex < savedCount) {
        unsigned long due = playbackIndex == savedCount - 1
            ? savedDuration : playbackIndex * (unsigned long)RECORD_INTERVAL;
        if (millis() - playbackStartedAt < due) return;
        writeFrame(motionBuffers[savedBuffer][playbackIndex++]);
    }
    mode = MODE_IDLE;
    Serial.println(F("DONE:PLAY"));
}

void printStatus() {
    Serial.print(F("STATE:"));
    switch (mode) {
        case MODE_IDLE: Serial.println(F("IDLE")); break;
        case MODE_AUTO_TASK: Serial.println(F("AUTO")); break;
        case MODE_RECORDING: Serial.println(F("RECORDING")); break;
        case MODE_PLAY_PREPARE: Serial.println(F("PLAY_PREPARE")); break;
        case MODE_PLAYBACK: Serial.println(F("PLAYBACK")); break;
        case MODE_HOME: Serial.println(F("HOME")); break;
        case MODE_POSE_REPLAY: Serial.println(F("POSE_REPLAY")); break;
        case MODE_DIRECT: Serial.println(F("DIRECT")); break;
    }
    Serial.print(F("ANGLES:")); Serial.print(baseAngle); Serial.print(',');
    Serial.print(rArmAngle); Serial.print(','); Serial.print(fArmAngle);
    Serial.print(','); Serial.println(clawAngle);
    Serial.print(F("RECORD:")); Serial.print(savedValid ? savedCount : 0);
    Serial.print(','); Serial.println(savedValid ? savedDuration : 0);
}

void processCommand(char *command) {
    // 高优先级命令先处理，不受普通BUSY限制。
    if (!strcmp(command, "?")) { printStatus(); return; }
    if (!strcmp(command, "HOME")) { moveHome(); return; }
    if (!strcmp(command, "X")) {
        stopAllMovement(); Serial.println(F("ACK:X")); return;
    }
    if (!strcmp(command, "STOP")) {
        if (mode == MODE_RECORDING) {
            updateRecording();
            if (mode == MODE_RECORDING) finishRecording(false);
        } else {
            stopAllMovement(); Serial.println(F("ACK:STOP"));
        }
        return;
    }
    if (!strcmp(command, "H")) { increaseSpeed(); return; }
    if (!strcmp(command, "L")) { decreaseSpeed(); return; }
    if (mode != MODE_IDLE) { Serial.println(F("BUSY")); return; }

    if (!strcmp(command, "A") || !strcmp(command, "B") || !strcmp(command, "C")) {
        startTask(command[0]);
        Serial.print(F("ACK:")); Serial.println(command[0]);
    } else if (!strcmp(command, "REC")) startRecording();
    else if (!strcmp(command, "PLAY")) startPlayback();
    else if (!strcmp(command, "O") || !strcmp(command, "S")) {
        syncTargets();
        if (command[0] == 'O') openClaw(); else closeClaw();
        mode = MODE_DIRECT;
        Serial.print(F("ACK:")); Serial.println(command[0]);
    } else if (!strcmp(command, "R")) recordCurrentPose();
    else if (!strcmp(command, "P")) showRecordedPoses();
    else if (!strcmp(command, "E")) startReplay();
    else if (command[0] == 'X') multiServoControl(command);
    else Serial.println(F("ERR:COMMAND"));
}

// 固定字符缓冲区，不使用String或readStringUntil，不等待串口超时。
void serialControl() {
    static char buffer[48];
    static byte length = 0;
    static bool overflow = false;
    // 每轮最多处理32字节，持续串口输入不能占死摇杆/录制调度。
    byte budget = 32;
    while (budget-- && Serial.available() > 0) {
        char ch = (char)Serial.read();
        if (ch == '\r') continue;
        if (ch == '\n') {
            if (overflow) Serial.println(F("ERR:COMMAND_TOO_LONG"));
            else {
                buffer[length] = '\0';
                char *begin = buffer;
                while (*begin && isspace((unsigned char)*begin)) ++begin;
                char *end = begin + strlen(begin);
                while (end > begin && isspace((unsigned char)end[-1])) *--end = '\0';
                for (char *p = begin; *p; ++p) *p = toupper((unsigned char)*p);
                if (*begin) processCommand(begin);
            }
            length = 0; overflow = false;
            return; // 每轮一条指令，然后及时更新动作
        }
        if (overflow) continue;
        if (length < sizeof(buffer) - 1) buffer[length++] = ch;
        else overflow = true; // 丢弃本行剩余字符，不能执行截断后的后缀
    }
}

void loop() {
    serialControl();
    joystickControl();
    updateAutoMovement();
    updateReplay();
    updateTask();
    updateRecording();
    updatePlayback();
    if (!autoMoving && (mode == MODE_HOME || mode == MODE_DIRECT)) {
        if (mode == MODE_HOME) Serial.println(F("DONE:HOME"));
        mode = MODE_IDLE;
    }
}
