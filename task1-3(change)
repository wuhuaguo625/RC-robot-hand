// ============================================================
//                14. 设置目标姿态
// ============================================================

// 这个函数只是设置目标角度
// 真正的逐步运动由updateAutoMovement完成

void moveToPose(Pose target) {

    // A的微调超出原软件范围，仅对A自动序列启用对应边界。
    const bool coinATask = (mode == MODE_AUTO_TASK && activeTask == 'A');
    const int fMin = coinATask ? min(FARM_MIN, (int)COIN_A_PICK_F) : FARM_MIN;
    const int cMax = coinATask ? max(CLAW_MAX, (int)COIN_A_GRIP_C) : CLAW_MAX;

    baseTarget = constrain(
        target.base,
        BASE_MIN,
        BASE_MAX
    );

    rArmTarget = constrain(
        target.rArm,
        RARM_MIN,
        RARM_MAX
    );

    fArmTarget = constrain(
        target.fArm,
        fMin,
        FARM_MAX
    );

    clawTarget = constrain(
        target.claw,
        CLAW_MIN,
        cMax
    );

    autoMoving = true;
}

// ============================================================
//                15. 判断是否到达姿态
// ============================================================

bool poseReached(Pose target) {

    return (
        baseAngle == target.base &&
        rArmAngle == target.rArm &&
        fArmAngle == target.fArm &&
        clawAngle == target.claw
    );
}

// ============================================================
//                16. 自动移动单个舵机
// ============================================================

// 每隔moveInterval毫秒改变1度
// 不使用delay阻塞主循环

void moveServoToTarget(
    int &currentAngle,
    int targetAngle,
    Servo &servo,
    unsigned long &lastMove
) {

    unsigned long now = millis();

    // 尚未达到下一次运动时间

    if (now - lastMove < (unsigned long)moveInterval) {
        return;
    }

    // 已经到达目标

    if (currentAngle == targetAngle) {
        return;
    }

    // 逐度接近目标

    if (currentAngle < targetAngle) {
        currentAngle++;
    }
    else {
        currentAngle--;
    }

    servo.write(currentAngle);

    lastMove = now;
}

// ============================================================
//                17. 更新自动运动
// ============================================================

void updateAutoMovement() {

    if (!autoMoving) {
        return;
    }

    // 四个舵机独立移动

    moveServoToTarget(
        baseAngle,
        baseTarget,
        base,
        lastBaseMove
    );

    moveServoToTarget(
        rArmAngle,
        rArmTarget,
        rArm,
        lastRArmMove
    );

    moveServoToTarget(
        fArmAngle,
        fArmTarget,
        fArm,
        lastFArmMove
    );

    moveServoToTarget(
        clawAngle,
        clawTarget,
        claw,
        lastClawMove
    );

    // 四个关节全部达到目标

    if (
        baseAngle == baseTarget &&
        rArmAngle == rArmTarget &&
        fArmAngle == fArmTarget &&
        clawAngle == clawTarget
    ) {

        autoMoving = false;
    }
}

// ============================================================
//                18. 判断自动任务是否在运行
