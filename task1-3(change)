bool taskRunning() {
    return activeTask != 0;
}

// ============================================================
//                19. 不同姿态的等待时间
// ============================================================

unsigned int taskWaitMs(char task, byte step) {

    // A/B/C都是第2个姿态夹紧物体，等待800ms稳定夹持

    if (step == 2) {
        return 800;
    }

    // 硬币第6个姿态松开

    if (task == 'A' && step == 6) {
        return 700;
    }

    // 笔B和物体C都在第5个姿态松开，等待700ms

    if ((task == 'B' || task == 'C') && step == 5) {
        return 700;
    }

    // 普通姿态等待100ms
    // 避免动作之间明显卡顿

    return 100;
}

// ============================================================
//                20. 中止自动抓取任务
// ============================================================

void cancelTask() {

    if (!taskRunning()) {
        return;
    }

    char cancelledTask = activeTask;
    taskReturning = false;
    mode = MODE_IDLE;

    activeTask = 0;

    activePoses = NULL;

    activePoseCount = 0;

    activeStepWaiting = false;

    // 清除笔B的预先转向状态

    penTurnFirst = false;

    penTurnSettling = false;

    // 停止自动运动

    autoMoving = false;

    // 将目标角度同步为当前角度
    // 防止取消以后继续运动

    baseTarget = baseAngle;
    rArmTarget = rArmAngle;
    fArmTarget = fArmAngle;
    clawTarget = clawAngle;

    Serial.print(F("Task Cancelled: "));
    Serial.println(cancelledTask);
}

// ============================================================
//                21. 开始任务A、B或C
// ============================================================

void startTask(char task) {

    if (taskRunning()) {

        Serial.println(F("Task Busy"));
        return;
    }

    // 选择姿态数组

    if (task == 'A') {

        activePoses = COIN_A_POSES;

        activePoseCount = COIN_A_COUNT;
    }

    else if (task == 'B') {

        activePoses = PEN_B_POSES;

        activePoseCount = PEN_B_COUNT;
    }

    else if (task == 'C') {

        activePoses = OBJECT_C_POSES;

        activePoseCount = OBJECT_C_COUNT;
    }

    else {

        Serial.println(F("Unknown Task"));
        return;
    }

    // 取消原来的手动姿态回放

    replaying = false;

    // 初始化任务

    activeTask = task;
    taskReturning = false;
    mode = MODE_AUTO_TASK;

    activeStep = 0;

    activeStepWaiting = false;

    penTurnFirst = false;

    penTurnSettling = false;

    Serial.print(F("Start Task: "));
    Serial.println(activeTask);

    // ====================================================
    // 关键修改：笔B先转向，再向前伸
    // ====================================================

    if (task == 'B') {

        // 开启预先转向阶段

        penTurnFirst = true;

        // 只修改底座角度
        // 大臂、小臂、夹爪保持当前位置不动

        Pose turnOnly = {

            125,        // 底座先转到125度

            (uint8_t)rArmAngle,  // 大臂保持当前角度

            (uint8_t)fArmAngle,  // 小臂保持当前角度

            (uint8_t)clawAngle   // 夹爪保持当前角度
        };

        moveToPose(turnOnly);

        Serial.println(F("B: Turning Base First"));
    }

    // ====================================================
    // 硬币A与物体C直接从各自的第0组姿态开始
    // ====================================================

    else {

        moveToPose(readTaskPose(0));
    }
}

// ============================================================
//                22. 自动任务执行状态机
// ============================================================

// 不断检测当前动作是否完成
// 到位后等待，再执行下一个姿态

void updateTask() {

    if (!taskRunning()) {
        return;
    }

    // 返回阶段也属于当前任务，尚未返回到位时保持BUSY。
    if (taskReturning) {
        if (autoMoving || !poseReached(TASK_RETURN_POSE)) return;
        Serial.print(F("DONE:"));
        Serial.println(activeTask);
        mode = MODE_IDLE;
        activeTask = 0;
        activePoses = NULL;
        activePoseCount = 0;
        activeStepWaiting = false;
        penTurnFirst = false;
        penTurnSettling = false;
        taskReturning = false;
        return;
    }

    // ====================================================
    // 笔B的特殊阶段：先转向
    // ====================================================

    if (activeTask == 'B' && penTurnFirst) {

        // 底座还在移动
        // 或者还没有到达125度

        if (
            autoMoving ||
            baseAngle != 125
        ) {
            return;
        }

        // 到达目标角度后，开始计时

        if (!penTurnSettling) {

            penTurnSettling = true;

            penTurnSettledAt = millis();

            Serial.println(F("B: Base Turn Finished"));

            return;
        }

        // 等待300ms，让实体舵机稳定

        if (
            millis() - penTurnSettledAt <
            PEN_TURN_WAIT
        ) {
            return;
        }

        // 转向阶段结束

        penTurnFirst = false;

        penTurnSettling = false;

        Serial.println(F("B: Moving Arm Forward"));

        // 现在才开始移动大臂、小臂、夹爪
        // 进入笔B的姿态0

        moveToPose(readTaskPose(0));

        return;
    }

    // ====================================================
    // 正常执行A/B/C的姿态序列
    // ====================================================

    // 当前还没有进入等待阶段

    if (!activeStepWaiting) {

        // 机械臂还在运动

        if (autoMoving) {
            return;
        }

        // 检查角度是否到位

        if (!poseReached(readTaskPose(activeStep))) {
            return;
        }

        // 已经到达当前姿态

        activeStepWaiting = true;

        activeWaitStart = millis();

        Serial.print(F("Task "));
        Serial.print(activeTask);

        Serial.print(F(" Pose "));
        Serial.println(activeStep);

        return;
    }

    // ====================================================
    // 等待当前姿态稳定
    // ====================================================

    if (
        millis() - activeWaitStart <
        taskWaitMs(activeTask, activeStep)
    ) {
        return;
    }

    // ====================================================
    // 进入下一个姿态
    // ====================================================

    activeStep++;

    // 判断任务是否全部完成

    if (activeStep >= activePoseCount) {
        taskReturning = true;
        moveToPose(TASK_RETURN_POSE);
        Serial.println(F("Returning:74,61,34,50"));
        return;
    }

    // 准备执行下一步

    activeStepWaiting = false;

    moveToPose(readTaskPose(activeStep));
}

