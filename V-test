}
void command(char *s){
    while(*s==' '||*s=='\t')++s;size_t length=strlen(s);
    while(length&&(s[length-1]==' '||s[length-1]=='\t'))s[--length]=0;
    for(char *p=s;*p;++p)*p=toupper((unsigned char)*p);if(!*s)return;
    if(!strcmp(s,"X")){stopHold();return;}
    if(!strcmp(s,"D")){stopHold();for(byte i=0;i<4;++i)motors[i].detach();enabled=false;Serial.println(F("DETACHED"));return;}
    if(!strcmp(s,"STOP")){if(mode==RECORDING)endRecord();else stopHold();return;}
    if(!strcmp(s,"?")||!strcmp(s,"T")||!strcmp(s,"STATUS")){printStatus();return;}
    if(!strcmp(s,"P")){
        if(mode!=MOVING&&mode!=PLAYING){Serial.println(F("ERR:NOT_PLAYING"));return;}
        if(!paused){paused=true;pauseStart=millis();}else{pauseTotal+=millis()-pauseStart;paused=false;lastControl=millis();}
        Serial.println(paused?F("PAUSED"):F("RESUMED"));return;
    }
    if(!strcmp(s,"H")||!strcmp(s,"L")){
        joyFullInterval=constrain((int)joyFullInterval+(!strcmp(s,"H")?-5:5),25,125);
        Serial.print(F("JOY full-stick step_ms="));Serial.println(joyFullInterval);return;
    }
    if(!strcmp(s,"K")){joyEnabled=false;Serial.println(F("JOY OFF"));return;}
    if(!strcmp(s,"JOY")&&(mode==IDLE||mode==RECORDING)){
        if(!enabled){Serial.println(F("ERR:E_FIRST"));return;}joyEnabled=true;resetJoyClock();Serial.println(F("JOY ON"));return;
    }
    if(!strcmp(s,"CJ")||!strcmp(s,"CL")){
        if(mode!=IDLE&&mode!=RECORDING){Serial.println(F("BUSY"));return;}
        clawLocked=!strcmp(s,"CL");Serial.println(clawLocked?F("CLAW LOCKED"):F("CLAW JOYSTICK ON"));return;
    }
    if(mode!=IDLE){Serial.println(F("BUSY; STOP or X first"));return;}
    if(!strcmp(s,"HELP")){help();return;}
    if(!strcmp(s,"E")){
        if(!enabled){for(byte i=0;i<4;++i){motors[i].attach(SERVO_PINS[i]);lastPulse[i]=-1;}enabled=true;outputPose();}
        clawLocked=true;PoseQ homePose={{360,360,360,480}};
        if(poseDelta(current,homePose)>0){
            beginMove(homePose);enableJoyAfterMove=true;Serial.println(F("E: moving to B90 R90 F90 C120; wait DONE:E_HOME"));
        }else{
            joyEnabled=true;resetJoyClock();Serial.println(F("ENABLED V3.3; B90 R90 F90 C120; joystick ON"));printAngles(current);
        }
        return;
    }
    if(!strcmp(s,"REC")||!strcmp(s,"R")){beginRecord();return;}
    if(!strcmp(s,"SAVE")){beginSave();return;}
    if(!strncmp(s,"TRIM",4)){
        char *end;unsigned long seconds=strtoul(s+4,&end,10);
        if(!isdigit((unsigned char)s[4])||*end||seconds<1||seconds>29){Serial.println(F("ERR:TRIM1..29"));return;}
        trimTail(seconds*1000UL);return;
    }
    if(!strcmp(s,"LOAD")){joyEnabled=false;Serial.println(loadEEPROM()?F("LOADED_EEPROM"):F("ERR:NO_VALID_EEPROM"));return;}
    if(!strcmp(s,"V")||!strcmp(s,"PLAY")){beginPlay();return;}
    if(!strcmp(s,"H0")||!strcmp(s,"G")){
        if(!enabled){Serial.println(F("ERR:E_FIRST"));return;}
        if(!recordValid){Serial.println(F("ERR:NO_RECORD"));return;}
        PoseQ target;memcpy(target.q,record.initial,sizeof(target.q));beginMove(target);return;
    }
    if(!strcmp(s,"CAL")){calibrateJoystick();return;}
    if(!strcmp(s,"DUMP")){dumpRecord();return;}
    if(!strcmp(s,"J")){for(byte i=0;i<4;++i){if(i)Serial.print(',');Serial.print(analogRead(JOY_PINS[i]));}Serial.println();return;}
    byte axis=4;for(byte i=0;i<4;++i)if(s[0]=="BRFC"[i])axis=i;
    if(axis<4&&s[1]){
        if(!enabled){Serial.println(F("ERR:E_FIRST"));return;}
        char *end;float angle;
        if(axis==3&&(!strcmp(s,"C+")||!strcmp(s,"C-")))angle=current.q[3]/4.0f+(s[1]=='+'?1:-1);
        else{angle=strtod(s+1,&end);if(end==s+1||*end||!isfinite(angle)){Serial.println(F("ERR:ANGLE"));return;}}
        if(angle<Q_MIN[axis]/4.0f||angle>Q_MAX[axis]/4.0f){Serial.println(F("ERR:JOINT_LIMIT"));return;}
        PoseQ target=current;target.q[axis]=(uint16_t)lroundf(angle*4);if(axis==3)clawLocked=true;beginMove(target);return;
    }
    Serial.println(F("ERR:COMMAND; HELP"));
}
void readSerial(){
    byte readCount=0;while(Serial.available()&&readCount++<32){
        char c=Serial.read();if(c=='\n'||c=='\r'){
            if(inputOverflow)Serial.println(F("ERR:LINE_TOO_LONG"));else if(inputUsed){input[inputUsed]=0;command(input);}
            inputUsed=0;inputOverflow=false;
        }else if(!inputOverflow){if(inputUsed<sizeof(input)-1)input[inputUsed++]=c;else inputOverflow=true;}
    }
}
void setup(){
    Serial.begin(9600);help();
    Serial.println(loadEEPROM()?F("EEPROM record restored; E to enable"):F("No saved record; E then REC to teach"));
}
void loop(){readSerial();updateJoystick();updateRecording();updateMotion();updateSave();}
